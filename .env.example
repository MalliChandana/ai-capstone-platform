# ===================================================
# AI Capstone Platform - Environment Configuration Example
# Copy this file to .env or configure in your Cloud Hosting Provider (Render / Railway / AWS / Heroku)
# ===================================================

# Server Port (assigned automatically by cloud platforms like Render / Railway)
PORT=8080

# Production MySQL Database Connection Details
DB_URL=jdbc:mysql://<DB_HOST>:3306/<DB_NAME>?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=admin_user
DB_PASSWORD=strong_production_password_here

# System Administrator Account
APP_ADMIN_EMAIL=admin@aicapstone.io
APP_ADMIN_PASSWORD=SuperSecureAdminPass2026!
APP_ADMIN_NAME=Platform Administrator

# Demo Data Flag (set to false in production)
APP_DEMO_DATA_ENABLED=false
